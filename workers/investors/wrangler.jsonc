{
  // Investor contact API for asanoha.co.in/investors.
  // Email is checked by the shared Asanoha sign-in (Supabase emails the code).
  // WhatsApp is checked with a code sent through the Noha Pay WhatsApp relay.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asanoha-investors",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Served on our own domain so the account's workers.dev name never shows in the page or the API.
  "workers_dev": false,
  "routes": [{ "pattern": "investors-api.peoplepitchers.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "asanoha-investors", "database_id": "1be68eb1-530b-4359-8baa-b3297b55d37b", "migrations_dir": "migrations" }
  ],
  "vars": {
    "WA_RELAY_URL": "https://wa.peoplepitchers.com/send",
    "ALLOWED_ORIGINS": "https://asanoha.co.in,http://localhost:4410",
    "EMAIL_FROM": "Asanoha <founders@asanoha.co.in>",
    "TEAM_EMAIL": "orders@asanoha.co.in",
    "TEAM_WHATSAPP": ""
  }
  // Secrets (wrangler secret put): WA_RELAY_TOKEN, CODE_SALT, RESEND_API_KEY (optional until the
  // asanoha.co.in domain is verified in Resend; without it, no emails are sent and the lead is still saved).
}
